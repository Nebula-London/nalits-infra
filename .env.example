# ===========================================
# RentOption Infrastructure - Environment Variables
# Copy to .env and customize all values
# ===========================================

# -----------------------------------------------------------------------------
# DOMAIN & NETWORK
# -----------------------------------------------------------------------------
# Public hostname for Keycloak (must have DNS A record pointing to this server)
KEYCLOAK_HOSTNAME=sso.rentoption.com

# Samba AD Domain
AD_DOMAIN=rentoption.com
AD_REALM=RENTOPTION.COM
AD_NETBIOS=RENTOPTION

# -----------------------------------------------------------------------------
# SAMBA AD CONFIGURATION
# -----------------------------------------------------------------------------
# Samba Administrator password (Domain Admin)
SAMBA_ADMIN_PASSWORD=ChangeMe_SambaAdmin_2024!

# DNS forwarder for Samba AD (use your ISP DNS or 8.8.8.8/1.1.1.1)
SAMBA_DNS_FORWARDER=8.8.8.8

# -----------------------------------------------------------------------------
# KEYCLOAK CONFIGURATION
# -----------------------------------------------------------------------------
# Keycloak Admin Console credentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=ChangeMe_KeycloakAdmin_2024!

# Keycloak Database (OCI Autonomous DB - Oracle)
# TLS only (mTLS disabled, no wallet). Service name MUST use the _tp tier
# (parallel DML disabled); _medium / _high break migration with ORA-12838.
KC_DB=oracle
KC_DB_URL=jdbc:oracle:thin:@(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1521)(host=adb.<region>.oraclecloud.com))(connect_data=(service_name=<DBNAME>_tp.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=ChangeMe_OracleDB_2024!
KC_DB_TLS_MODE=verify-server

# Keycloak HTTP/HTTPS ports (internal)
KC_HTTP_PORT=8080
KC_HTTPS_PORT=8443

# Keycloak hostname settings
# KC_HOSTNAME: must match the public hostname (used in OIDC issuer, admin console URLs)
KC_HOSTNAME=sso.rentoption.com
# KC_HOSTNAME_STRICT: false = allow any hostname, true = only KC_HOSTNAME
KC_HOSTNAME_STRICT=false
# KC_HOSTNAME_STRICT_HTTPS: true = generate https:// URLs behind reverse proxy
KC_HOSTNAME_STRICT_HTTPS=true

# Keycloak log level
KC_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# LDAP ACCOUNT MANAGER (LAM) CONFIGURATION
# -----------------------------------------------------------------------------
# LAM Admin password (for web UI login)
LAM_PASSWORD=ChangeMe_LAM_2024!

# -----------------------------------------------------------------------------
# CERTBOT / LET'S ENCRYPT CONFIGURATION
# -----------------------------------------------------------------------------
# Email for Let's Encrypt registration and expiry notices
CERTBOT_EMAIL=admin@rentoption.com

# Staging environment for testing (set to 0 for production)
CERTBOT_STAGING=0

# Domains to obtain certificates for (space-separated)
CERTBOT_DOMAINS=sso.rentoption.com

# -----------------------------------------------------------------------------
# NGINX CONFIGURATION
# -----------------------------------------------------------------------------
# Nginx worker processes (auto = CPU cores)
NGINX_WORKER_PROCESSES=auto

# Client max body size for file uploads
NGINX_CLIENT_MAX_BODY_SIZE=100M

# ===========================================
# SECURITY NOTES:
# - NEVER commit .env to version control
# - Use strong, unique passwords for all services
# - Rotate passwords periodically
# - For production: set CERTBOT_STAGING=0
# ===========================================
